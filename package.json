{
  "name": "nest-boilerplate",
  "version": "0.0.0",
  "private": true,
  "description": "Nest boilerplate",
  "license": "UNLICENSED",
  "author": "Samuel MARLHENS",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "eslint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "eslint:fix": "npm run eslint:check -- --fix",
    "lint": "run-p eslint:check prettier:check",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "prettier:check": "prettier --check ./**/*.{ts,js,json,*rc}",
    "prettier:write": "prettier --write ./**/*.{ts,js,json,*rc}",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "10.4.20",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/typeorm": "12.0.1",
    "joi": "18.0.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "typeorm": "0.3.26"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.11",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "lint-staged": "17.5.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "sort-package-json": "4.0.0",
    "supertest": "7.2.2",
    "taze": "21.1.0",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "fsevents": "2.3.3"
  },
  "engines": {
    "node": "^20.17.0 || ^22.0.0 || ^24.0.0",
    "npm": ">=10.0.0"
  }
}
